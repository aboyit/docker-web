[mysqld]
# ==========================================
# 1. TỐI ƯU KẾT NỐI & MẠNG (NETWORK & CONNECTIONS)
# ==========================================
max_connections         = 300          # Đủ lớn để không từ chối kết nối lúc cao điểm
max_allowed_packet      = 128M         # Tăng lên 128MB để import/export DB lớn, không bị lỗi "gone away"
connect_timeout         = 10
wait_timeout            = 300          # Giảm xuống 5 phút (thay vì 8 tiếng mặc định) để tự động ngắt các kết nối rác, giải phóng RAM
interactive_timeout     = 300
skip-name-resolve       = 1            # SIÊU QUAN TRỌNG: Tắt phân giải DNS ngược. Tiết kiệm hàng chục mili-giây cho mỗi kết nối mới.

# ==========================================
# 2. TỐI ƯU BỘ ĐỆM BẢNG & THREAD (MEMORY & CACHE)
# ==========================================
thread_cache_size       = 64           # Giữ lại 64 luồng kết nối trong RAM để tái sử dụng ngay lập tức thay vì tạo mới
table_open_cache        = 4000         # Số lượng bảng được mở và giữ trong RAM (Tăng tốc đọc DB có nhiều tables)
table_definition_cache  = 2000

# Bảng tạm (Temporary Tables): Cực kỳ quan trọng cho các câu lệnh GROUP BY, ORDER BY
# Ép MariaDB lưu bảng tạm trên RAM thay vì ghi xuống ổ cứng (rất chậm)
max_heap_table_size     = 128M
tmp_table_size          = 128M         # Hai chỉ số này bắt buộc phải bằng nhau

# Tắt hoàn toàn Query Cache của MySQL (Vì bác đã dùng Redis lo phần này)
query_cache_type        = 0
query_cache_size        = 0

# ==========================================
# 3. TỐI ƯU LÕI INNODB (INNODB ENGINE TUNING)
# ==========================================
innodb_file_per_table   = 1            # Mỗi bảng là 1 file vật lý riêng, chống phân mảnh

# Buffer Pool: Bộ não của MariaDB (Nơi chứa Data & Index trên RAM)
# Mức 1GB này giả định server bác có 4GB RAM. Nếu server 8GB RAM, hãy tăng lên 4G hoặc 5G.
innodb_buffer_pool_size = 1G           
innodb_buffer_pool_instances = 1       # Nếu buffer_pool_size từ 2G trở lên, hãy đổi số này thành 2 hoặc 4 để chống nghẽn cổ chai

# Tối ưu Ghi log (Redo Log)
innodb_log_file_size    = 256M         # Dung lượng file log. File càng to thì càng ít phải ghi lắt nhắt xuống ổ cứng
innodb_log_buffer_size  = 64M          # Bộ nhớ đệm trước khi ghi xuống file log

# Tốc độ vs An toàn (ACID)
innodb_flush_log_at_trx_commit = 2     # Đặt = 2: Hiệu năng ghi dữ liệu (INSERT/UPDATE/DELETE) tăng gấp nhiều lần so với mức 1 (mặc định), đánh đổi nguy cơ mất 1 giây dữ liệu nếu sập nguồn đột ngột.
innodb_flush_method     = O_DIRECT     # Yêu cầu MariaDB ghi thẳng xuống ổ cứng, bỏ qua lớp Cache của hệ điều hành Linux (tránh tốn RAM gấp đôi vô ích)

# ==========================================
# 4. TỐI ƯU LUỒNG I/O CHO Ổ SSD/NVMe (I/O CAPACITY)
# ==========================================
# Cấu hình này báo cho MariaDB biết bác đang dùng ổ SSD tốc độ cao để nó vắt kiệt công suất
innodb_io_capacity      = 2000         # (Mặc định chỉ là 200 cho ổ HDD quay). 
innodb_io_capacity_max  = 4000
innodb_read_io_threads  = 8            # Tăng luồng đọc dữ liệu nền
innodb_write_io_threads = 8            # Tăng luồng ghi dữ liệu nền